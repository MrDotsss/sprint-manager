{
  "compilerOptions": {
    /* Target and Module */
    "target": "ES2022" /* Specify ECMAScript target version */,
    "module": "NodeNext" /* Specify module code generation style */,
    "moduleResolution": "NodeNext" /* Determine how modules get resolved */,

    /* Directories */
    "rootDir": "./src" /* Specify the root folder of input files */,
    "outDir": "./dist" /* Redirect output structure to the directory */,

    /* Strict Type-Checking Options */
    "strict": true /* Enable all strict type-checking options */,
    "noImplicitAny": true /* Raise error on expressions and declarations with an implied 'any' type */,
    "strictNullChecks": true /* Enable strict null checks */,

    /* Module Discovery */
    "esModuleInterop": true /* Emits additional JavaScript to ease support for importing CommonJS modules */,
    "skipLibCheck": true /* Skip type checking of declaration files */,
    "forceConsistentCasingInFileNames": true /* Disallow inconsistently-cased references to the same file */,
    "resolveJsonModule": true /* Allows importing modules with a '.json' extension */,
    "sourceMap": true /* Generates corresponding '.map' file for debugging */
  },
  "include": ["src/**/*"] /* Include all files in the src directory */,
  "exclude": [
    "node_modules",
    "dist",
    "src/generated"
  ] /* Exclude dependencies and build outputs */
}
